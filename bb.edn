{:min-bb-version "1.13.225"
 :paths ["src" "test" "examples"]
 :tasks
 {test {:doc "Run the tests under Babashka."
        :task (apply (requiring-resolve 'presa.test-runner/-main) *command-line-args*)}
  jvm-test {:doc "Run the same tests on the JVM, plus the JVM-only ones."
            :task (shell "clojure -M:test")}
  lint {:doc "Check the repository conventions: no em dashes, conventional commits since origin/main."
        :task (apply shell "bb dev/lint.clj" *command-line-args*)}
  conformance {:doc "Run the official conformance runner: the server leg against the fixture (bb conformance <revision>), or the client leg against the harness (bb conformance client <revision>)."
               :task (apply shell "bb conformance/run.clj" *command-line-args*)}}}
